{
  "name": "reuse-api",
  "version": "2.0.0",
  "private": true,
  "description": "API REST do ReUse! (Node.js + Express + Prisma) com área administrativa low-code (AdminJS).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "prisma generate && tsc --noEmit && npm run admin:bundle",
    "start": "tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "admin:bundle": "NODE_ENV=production tsx scripts/bundle-admin.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/prisma": "^5.0.4",
    "@prisma/client": "^5.22.0",
    "adminjs": "^7.8.17",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@adminjs/bundler": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
