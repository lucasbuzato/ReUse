# Banco PostgreSQL (Neon em produção)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reuse?schema=public"

# Mesmo segredo usado na sessão da plataforma (cookie reuse_session)
AUTH_SECRET="troque-esta-chave-por-uma-string-secreta"

# URL pública do frontend (links do painel e CORS)
FRONTEND_URL="http://localhost:3000"
# Outras origens permitidas, separadas por vírgula (opcional)
CORS_ORIGINS=""

# Assistente IBM watsonx (mesmos valores do projeto anterior)
ASSISTANT_ACTION_SECRET=""
ASSISTANT_EXTENSION_API_KEY=""
ASSISTANT_WEB_CHAT_PRIVATE_KEY_BASE64=""
ASSISTANT_WEB_CHAT_IBM_PUBLIC_KEY_BASE64=""

PORT=4000

# Seed de demonstração (obrigatório fora do banco local)
SEED_PASSWORD=""

# Criação de contas do painel: npm run admin:create
# ADMIN_EMAIL="" ADMIN_PASSWORD="" ADMIN_NAME="" ADMIN_ROLE="ADMIN|VIEWER"
