DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reuse?schema=public"
AUTH_SECRET="troque-esta-chave-por-uma-string-secreta"

# Assinatura de tokens curtos usados pelas ações do assistente (mínimo: 32 caracteres)
ASSISTANT_ACTION_SECRET="gere-um-segredo-independente-com-openssl-rand-hex-32"

# Chave configurada também na extensão IBM como X-ReUse-Extension-Key
ASSISTANT_EXTENSION_API_KEY="gere-outra-chave-com-openssl-rand-hex-32"

# Identificadores públicos copiados da integração Web Chat do watsonx Assistant
NEXT_PUBLIC_IBM_ASSISTANT_INTEGRATION_ID=""
NEXT_PUBLIC_IBM_ASSISTANT_REGION=""
NEXT_PUBLIC_IBM_ASSISTANT_SERVICE_INSTANCE_ID=""
NEXT_PUBLIC_IBM_ASSISTANT_WEB_CHAT_VERSION="latest"
